# Copy this file to .env (which git ignores) and fill in your key.
# Get a key at https://console.anthropic.com  (set a monthly spend limit of about $20 under Billing / Limits)
ANTHROPIC_API_KEY=

# Model used by the agent. Sonnet is the best default for tool use;
# switch to claude-haiku-5-5 to cut cost while you experiment.
CLAUDE_MODEL=claude-sonnet-5-5

# Filled in on Day 8, when you self-host Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
